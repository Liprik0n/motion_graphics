# Шаблон. Скопируй этот файл в .env рядом с ним (project/.env) и впиши значения.
# В коде, отчётах и логах фигурируют только ИМЕНА переменных; значения не печатаются
# нигде (redact() затирает значения всех переменных этого файла в любом выводе).
# Попал ключ в переписку — отозвать и выпустить новый.

# --- Озвучка: MiniMax (имена берутся из project/voices.json) ------------------
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# voice_id голосов a и b — после Voice Design и проверки «tts.py --voices»
MINIMAX_VOICE_A=
MINIMAX_VOICE_B=
